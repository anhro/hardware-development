(version 1)

# J5 і XT1 навмисно виступають за верхній край плати (кабель під'єднують збоку).
# Контур корпусу на шовкографії перетинає Edge.Cuts; поза платою його не друкують.
# Від'ємний мінімум: лінія, що перетинає край, має зазор 0 і не проходить з min 0mm.
(rule "Overhanging connectors: silk outline may cross board edge"
  (layer outer)
  (constraint silk_clearance (min -2mm))
  (condition "(A.memberOfFootprint('J5') || A.memberOfFootprint('XT1')) && B.Layer == 'Edge.Cuts'"))

# ДЗ 13, п. 3. Клас HIGH_CURRENT: 4 А × 2 = 8 А, зовнішній шар 1 oz, ΔT ≈ 20 °C
# (IPC-2221) → 3.5 мм. Внутрішні шари 0.5 oz для цього струму не годяться.
(rule high_current
  (condition "A.NetClass == 'HIGH_CURRENT'")
  (constraint track_width (min 3.5mm) (opt 3.5mm))
  (constraint clearance (min 0.2mm))
  (constraint via_diameter (min 0.8mm))
  (constraint hole_size (min 0.4mm)))

# Звуження до ширини пада (PVDD U2, U3, F1, VD3, витоки DPAK) — лише в межах
# courtyard компонента. Правило нижче має вищий пріоритет за high_current.
(rule high_current_neckdown
  (condition "A.NetClass == 'HIGH_CURRENT' && A.Type == 'Track' && A.intersectsCourtyard('*')")
  (constraint track_width (min 0.5mm) (opt 3.5mm)))

# Силові SMD-пади з'єднуються з полігонами суцільно: thermal relief зменшує
# переріз міді на шляху струму. THT (XT1, J5) лишаються з термобар'єром для пайки.
(rule high_current_zone_smd
  (condition "A.NetClass == 'HIGH_CURRENT' && A.Type == 'Pad' && A.Pad_Type == 'SMD'")
  (constraint zone_connection solid))
